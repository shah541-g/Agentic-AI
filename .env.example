# ==============================================================================
# Agentic AI Mastery - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file containing live secrets to GitHub.
# ==============================================================================

# Google Gemini API Key (Required for M0-M4 agents)
# Get your free key at: https://aistudio.google.com/
API_KEY=your_gemini_api_key_here

# SQLite Database Location (Default: agent_system.db)
DB_PATH=agent_system.db

# Optional: MySQL Credentials (for C5 MySQL deliverables if used)
host=localhost
user=root
password=your_database_password_here
database=agent_memory

# Optional: Pinecone Vector Database (for M5-M8)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=agentic-index

# Optional: LangSmith Observability (for M3, M7, M8)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-ai-mastery
